DEEPSEEK_API_KEY=sk-your-api-key

# Optional overrides
# DSCODE_HOME=~/.dscode
# DSCODE_SESSIONS_DIR=~/.dscode/sessions
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DSCODE_MODEL=deepseek-v4-flash
# DSCODE_EFFORT=high
# DSCODE_TRANSPORT=responses
# DSCODE_HARNESS=minimal
# DSCODE_PERMISSION=auto
# DSCODE_SANDBOX=workspace-write
# DSCODE_SANDBOX_IMAGE=your-reviewed-image:tag

# --- docker compose (docker-compose.example.yml) ---
# Each local instance needs a unique name and host port. The instance name is
# used as both the Compose project name and the container name, and therefore
# also namespaces the instance's home and workspace volumes.
DSCODE_INSTANCE_NAME=dscode
DSCODE_HOST_PORT=8899

# Credentials for the web-ui chat server. WORKSPACE_ID is the deployment's
# bearer credential — use a random high-entropy value, not a guessable one.
WORKSPACE_ID=replace-with-a-random-high-entropy-id
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
MODEL=your-openrouter-model-id
VISION_MODEL=your-vision-capable-openrouter-model-id
# Selects deploy/prompt-profiles/<name>/SYSTEM.md. Add a directory there to add a profile.
DSCODE_PROMPT_PROFILE=steve
# CHAT_AGENT_NAME=Steve Code
# CORS_ORIGINS=https://app.example.com
# DSCODE_IMAGE=dscode-server        # override for dev: dscode-server:lean
