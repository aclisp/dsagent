DEEPSEEK_API_KEY=sk-your-api-key

# Optional overrides
# DSCODE_HOME=~/.dscode
# DSCODE_SESSIONS_DIR=~/.dscode/sessions
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DSCODE_MODEL=deepseek-v4-flash
# DSCODE_EFFORT=high
# DSCODE_TRANSPORT=responses
# DSCODE_HARNESS=minimal
# DSCODE_PERMISSION=auto
# DSCODE_SANDBOX=workspace-write
# DSCODE_SANDBOX_IMAGE=your-reviewed-image:tag

# --- docker compose (docker-compose.example.yml) ---
# Credentials for the web-ui chat server. WORKSPACE_ID is the deployment's bearer
# credential — use a random high-entropy value, not a guessable one.
WORKSPACE_ID=replace-with-a-random-high-entropy-id
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
MODEL=your-openrouter-model-id
VISION_MODEL=your-vision-capable-openrouter-model-id
# DSCODE_IMAGE=dscode-server        # override for dev: dscode-server:lean
