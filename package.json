{
  "name": "@thinkany/dscode",
  "version": "0.3.6",
  "description": "A local-first, multi-provider coding agent with DeepSeek defaults.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/thinkany-ai/dscode#readme",
  "bugs": {
    "url": "https://github.com/thinkany-ai/dscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkany-ai/dscode.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.27.0",
  "files": [
    "assets",
    "dist",
    "packages/core/dist",
    "packages/core/package.json",
    "packages/core/README.md",
    "packages/core/LICENSE",
    "docs",
    "editors",
    "scripts/install-message.mjs",
    "scripts/postinstall.mjs",
    "scripts/live-smoke.mjs",
    "scripts/live-features.mjs",
    ".env.example",
    "README.md"
  ],
  "bin": {
    "dscode": "./dist/cli.js",
    "dscode-vision": "./dist/vision-cli.js"
  },
  "scripts": {
    "build:core": "pnpm --dir packages/core build",
    "build:http-adapter": "pnpm --dir packages/http-adapter build",
    "build:chat-client": "pnpm --dir packages/chat-client build",
    "build:wecom": "pnpm --dir packages/wecom build",
    "build:web-ui": "pnpm --dir packages/web-ui build",
    "wecom-discover": "pnpm --dir packages/wecom wecom-discover",
    "bundle:server": "node scripts/bundle-server.mjs",
    "bundle:vision": "node scripts/bundle-vision-cli.mjs",
    "build:packages": "pnpm build:core && pnpm build:http-adapter && pnpm build:chat-client && pnpm build:wecom && pnpm build:web-ui && pnpm bundle:server",
    "build:windows-sandbox": "node scripts/build-windows-sandbox.mjs",
    "build": "pnpm build:packages && tsc -p tsconfig.json && pnpm bundle:vision",
    "postbuild": "node -e \"const fs=require('node:fs'); for (const file of ['dist/cli.js','dist/vision-cli.js']) fs.chmodSync(file, 0o755)\"",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "pnpm build && pnpm build:windows-sandbox",
    "prepublishOnly": "pnpm check",
    "predev": "pnpm build:core",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "package:check": "node scripts/package-smoke.mjs",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm package:check",
    "smoke:live": "pnpm build && node scripts/live-smoke.mjs",
    "features:live": "pnpm build && node scripts/live-features.mjs",
    "acceptance:live": "pnpm check && node scripts/live-smoke.mjs && node scripts/live-features.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "fast-glob": "catalog:",
    "picocolors": "catalog:",
    "typebox": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
