{
  "name": "@aclisp/dsagent-core",
  "version": "0.9.5",
  "private": true,
  "description": "Reusable multi-provider DSCode agent runtime with local sessions, tools, and RPC.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/aclisp/dsagent#readme",
  "bugs": {
    "url": "https://github.com/aclisp/dsagent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aclisp/dsagent.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc-client.d.ts",
      "import": "./dist/rpc-client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:windows-sandbox": "node ../../scripts/build-windows-sandbox.mjs",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/rpc-entry.js', 0o755)\"",
    "prepack": "pnpm build && pnpm build:windows-sandbox",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@napi-rs/keyring": "catalog:",
    "fast-glob": "catalog:",
    "picocolors": "catalog:",
    "typebox": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
