{
  "name": "@thinkany/dscode-core",
  "version": "0.3.3",
  "description": "Reusable DSCode agent runtime with DeepSeek, OpenAI API, and Codex subscription support.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/thinkany-ai/dscode#readme",
  "bugs": {
    "url": "https://github.com/thinkany-ai/dscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkany-ai/dscode.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc-client.d.ts",
      "import": "./dist/rpc-client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/rpc-entry.js', 0o755)\"",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "typebox": "^1.3.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "^5.9.2"
  }
}
