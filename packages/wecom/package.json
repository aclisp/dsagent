{
  "name": "@thinkany/dscode-wecom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discover": {
      "types": "./dist/wecom-discover.d.ts",
      "import": "./dist/wecom-discover.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "wecom-discover": "node dist/wecom-discover.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@thinkany/dscode-chat-client": "workspace:*",
    "@wecom/aibot-node-sdk": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
